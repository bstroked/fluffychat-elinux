+// SPDX-FileCopyrightText: 2019-Present Contributors to FluffyChat
+//
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+import 'package:fluffychat/config/setting_keys.dart';
+import 'package:flutter/foundation.dart';
+
+/// Remembers which voice-note event IDs the user has started playing.
+class PlayedVoiceNotes {
+  PlayedVoiceNotes._();
+
+  static const storeKey = 'chat.fluffy.played_voice_notes';
+  static const maxIds = 2000;
+
+  static final ValueNotifier<int> revision = ValueNotifier(0);
+  static final Set<String> _ids = {};
+  static bool _loaded = false;
+
+  static void _ensureLoaded() {
+    if (_loaded) return;
+    _loaded = true;
+    final raw = AppSettings.store.getStringList(storeKey);
+    if (raw != null) _ids.addAll(raw);
+  }
+
+  static bool hasPlayed(String eventId) {
+    _ensureLoaded();
+    return _ids.contains(eventId);
+  }
+
+  static Future<void> markPlayed(String eventId) async {
+    _ensureLoaded();
+    if (eventId.isEmpty || _ids.contains(eventId)) return;
+    _ids.add(eventId);
+    while (_ids.length > maxIds) {
+      _ids.remove(_ids.first);
+    }
+    await AppSettings.store.setStringList(storeKey, _ids.toList());
+    revision.value++;
+  }
+}
