diff --git a/lib/utils/linux_image_resizer.dart b/lib/utils/linux_image_resizer.dart
new file mode 100644
index 000000000..c34fb3c20
--- /dev/null
+++ b/lib/utils/linux_image_resizer.dart
@@ -0,0 +1,128 @@
+// SPDX-FileCopyrightText: 2019-Present Christian Kußowski
+// SPDX-FileCopyrightText: 2019-Present Contributors to FluffyChat
+//
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+import 'dart:ui' as ui;
+
+import 'package:blurhash_dart/blurhash_dart.dart';
+import 'package:flutter/foundation.dart';
+import 'package:flutter/painting.dart';
+import 'package:image/image.dart' as img;
+import 'package:matrix/matrix.dart';
+
+(int, int) _scaleToBox(int width, int height, {required int boxSize}) {
+  final fit = applyBoxFit(
+    BoxFit.scaleDown,
+    Size(width.toDouble(), height.toDouble()),
+    Size(boxSize.toDouble(), boxSize.toDouble()),
+  ).destination;
+  return (fit.width.round(), fit.height.round());
+}
+
+/// eLinux-friendly resizer: Skia decodes at the target size, then `package:image`
+/// encodes JPEG. Avoids `native_imaging` (Android/iOS only) and the Matrix
+/// SDK's full-resolution pure-Dart decode path.
+Future<MatrixImageFileResizedResponse?> linuxCustomImageResizer(
+  MatrixImageFileResizeArguments arguments,
+) async {
+  var imageBytes = arguments.bytes;
+  String? blurhash;
+  var originalWidth = 0;
+  var originalHeight = 0;
+  var width = 0;
+  var height = 0;
+  String? mimeType;
+
+  try {
+    // First pass: natural size + frame count (no target scale).
+    final probe = await ui.instantiateImageCodec(arguments.bytes);
+    final probeFrame = await probe.getNextFrame();
+    originalWidth = probeFrame.image.width;
+    originalHeight = probeFrame.image.height;
+    width = originalWidth;
+    height = originalHeight;
+    final frameCount = probe.frameCount;
+    probeFrame.image.dispose();
+    probe.dispose();
+
+    // Keep animated images as-is (scaling would drop frames).
+    if (frameCount > 1) {
+      return MatrixImageFileResizedResponse(
+        bytes: imageBytes,
+        width: width,
+        height: height,
+        originalWidth: originalWidth,
+        originalHeight: originalHeight,
+        blurhash: null,
+        mimeType: null,
+      );
+    }
+
+    final max = arguments.maxDimension;
+    int? targetWidth;
+    int? targetHeight;
+    if (width > max || height > max) {
+      (width, height) = _scaleToBox(width, height, boxSize: max);
+      targetWidth = width;
+      targetHeight = height;
+    }
+
+    final codec = await ui.instantiateImageCodec(
+      arguments.bytes,
+      targetWidth: targetWidth,
+      targetHeight: targetHeight,
+    );
+    final frame = await codec.getNextFrame();
+    width = frame.image.width;
+    height = frame.image.height;
+    final rgbaData = await frame.image.toByteData(
+      format: ui.ImageByteFormat.rawRgba,
+    );
+    frame.image.dispose();
+    codec.dispose();
+
+    if (rgbaData == null) return null;
+
+    final rgba = Uint8List.view(
+      rgbaData.buffer,
+      rgbaData.offsetInBytes,
+      rgbaData.lengthInBytes,
+    );
+    final decoded = img.Image.fromBytes(
+      width: width,
+      height: height,
+      bytes: rgba.buffer,
+      bytesOffset: rgba.offsetInBytes,
+      order: img.ChannelOrder.rgba,
+      numChannels: 4,
+    );
+
+    if (arguments.calcBlurhash) {
+      final (blurW, blurH) = _scaleToBox(width, height, boxSize: 100);
+      final small = img.copyResize(
+        decoded,
+        width: blurW,
+        height: blurH,
+        interpolation: img.Interpolation.linear,
+      );
+      blurhash = BlurHash.encode(small, numCompX: 3, numCompY: 3).hash;
+    }
+
+    imageBytes = Uint8List.fromList(img.encodeJpg(decoded, quality: 75));
+    mimeType = 'image/jpeg';
+  } catch (e, s) {
+    Logs().e('Could not generate Linux image preview', e, s);
+    mimeType = null;
+  }
+
+  return MatrixImageFileResizedResponse(
+    bytes: imageBytes,
+    width: width,
+    height: height,
+    originalWidth: originalWidth,
+    originalHeight: originalHeight,
+    blurhash: blurhash,
+    mimeType: mimeType,
+  );
+}
diff --git a/lib/utils/lomiri_url_handler.dart b/lib/utils/lomiri_url_handler.dart
new file mode 100644
index 000000000..2eecd753b
--- /dev/null
+++ b/lib/utils/lomiri_url_handler.dart
@@ -0,0 +1,46 @@
+import 'package:flutter/services.dart';
+import 'package:flutter/widgets.dart';
+
+import 'package:matrix/matrix.dart';
+
+import 'package:fluffychat/widgets/fluffy_chat_app.dart';
+
+/// Opens the room behind a URL dispatched by lomiri-url-dispatcher, which is
+/// how a tapped push notification reaches the app.
+///
+/// The runner owns the platform side: it takes the URL off the command line
+/// when the tap starts the app, and off org.freedesktop.Application.Open when
+/// the app is already running. The launch URL is pulled once with
+/// getInitialUrl, because the handler below is only installed after startup.
+abstract class LomiriUrlHandler {
+  static const MethodChannel _channel = MethodChannel('fluffychat/url');
+
+  static void init() {
+    _channel.setMethodCallHandler((call) async {
+      if (call.method == 'openUrl') {
+        _open(call.arguments as String?);
+      }
+      return null;
+    });
+    _channel.invokeMethod<String>('getInitialUrl').then(_open).catchError(
+      (Object e, StackTrace s) => Logs().w('Unable to get the launch URL', e, s),
+    );
+  }
+
+  static void _open(String? url) {
+    if (url == null || url.isEmpty) return;
+
+    // The push helper builds these as fluffychat://<room id>.
+    final roomId = url.replaceFirst(RegExp('^fluffychat:/*'), '');
+    if (!roomId.startsWith('!')) {
+      Logs().w('Ignoring URL with no room id', url);
+      return;
+    }
+
+    Logs().d('Opening room from URL', roomId);
+    // The router is not mounted yet when this is the launch URL.
+    WidgetsBinding.instance.addPostFrameCallback(
+      (_) => FluffyChatApp.router.go('/rooms/$roomId'),
+    );
+  }
+}
