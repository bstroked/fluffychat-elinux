diff --git a/lib/pages/chat_list/space_sidebar.dart b/lib/pages/chat_list/space_sidebar.dart
new file mode 100644
index 000000000..2f0e1263c
--- /dev/null
+++ b/lib/pages/chat_list/space_sidebar.dart
@@ -0,0 +1,324 @@
+// SPDX-FileCopyrightText: 2019-Present Contributors to FluffyChat
+//
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+import 'dart:convert';
+
+import 'package:fluffychat/config/app_config.dart';
+import 'package:fluffychat/config/setting_keys.dart';
+import 'package:fluffychat/l10n/l10n.dart';
+import 'package:fluffychat/utils/matrix_sdk_extensions/matrix_locals.dart';
+import 'package:fluffychat/utils/contact_book.dart';
+import 'package:fluffychat/widgets/avatar.dart';
+import 'package:fluffychat/widgets/matrix.dart';
+import 'package:flutter/material.dart';
+import 'package:matrix/matrix.dart';
+
+abstract class SpaceSidebar {
+  static const sortKey = 'chat.fluffy.sort_spaces_by_activity';
+  static const orderKey = 'chat.fluffy.space_sidebar_order';
+  static const hiddenKey = 'chat.fluffy.hidden_sidebar_spaces';
+
+  static bool get sortByActivity =>
+      AppSettings.store.getBool(sortKey) ?? true;
+
+  static Future<void> setSortByActivity(bool value) =>
+      AppSettings.store.setBool(sortKey, value);
+
+  static List<String> _ids(String key) {
+    final raw = AppSettings.store.getString(key);
+    if (raw == null || raw.isEmpty) return [];
+    try {
+      return List<String>.from(jsonDecode(raw));
+    } catch (_) {
+      return [];
+    }
+  }
+
+  static Future<void> _setIds(String key, List<String> ids) =>
+      AppSettings.store.setString(key, jsonEncode(ids));
+
+  static Set<String> get hiddenIds => _ids(hiddenKey).toSet();
+
+  static List<String> get orderIds => _ids(orderKey);
+
+  static List<Room> visible(Iterable<Room> all) {
+    final hidden = hiddenIds;
+    final order = orderIds;
+    final shown = all.where((s) => !hidden.contains(s.id)).toList();
+    if (order.isEmpty) return shown;
+    shown.sort((a, b) {
