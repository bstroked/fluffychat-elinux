+
+/// FluffyChat's own phone-number → name book.
+///
+/// Chat lists only look up this in-memory map. The Ubuntu Touch address
+/// book is read when the user taps Refresh in Chat settings, then the
+/// compact list is stored in SharedPreferences.
+///
+/// WhatsApp LID ghosts have no phone digits. Their previous display name
+/// (or a name the user assigns) is stored in [overlays] keyed by MXID.
+///
+/// When the bridge replaces a real WhatsApp name with a bare number, the
+/// last real name is kept in [remembered] and shown if no contact matches.
+///
+/// The background push helper cannot reach SharedPreferences, so every
+/// change is also exported to `contact_names.json` in the app cache dir.
+class ContactBook {
+  ContactBook._();
+
+  static const storeKey = 'chat.fluffy.contact_book';
+  static const exportFileName = 'contact_names.json';
+  static final ValueNotifier<int> revision = ValueNotifier(0);
+
+  static final Map<String, String> _names = {};
+  static final Map<String, String> _overlays = {};
+  static final Map<String, String> _remembered = {};
+  static final Map<String, String> _resolved = {};
+  static int _people = 0;
+  static DateTime? _lastSync;
+  static int _harvestPass = 0;
+  static bool _persistScheduled = false;
+
+  static int get people => _people;
+  static DateTime? get lastSync => _lastSync;
+
+  static final _nonDigit = RegExp(r'\D');
+  static final _leadingZeros = RegExp(r'^0+');
+  static final _bridgeTag = RegExp(r'\s*\((WA|Signal|Telegram|SMS)\)$');
+  static final _letter = RegExp(r'[^\W\d_]', unicode: true);
+  static const _bridgePrefixes = [
+    'whatsapp_',
+    'signal_',
+    'telegram_',
+    'sms_',
+  ];
+
+  /// Load the cached book from disk. Does not talk to the phone address book.
+  static void load() {
+    if (!PlatformInfos.isLinux) return;
+    final raw = AppSettings.store.getString(storeKey);
+    if (raw == null || raw.isEmpty) return;
+    try {
+      final decoded = jsonDecode(raw);
+      if (decoded is! Map) return;
+      final rows = decoded['contacts'];
+      if (rows is List) {
+        _applyRows(rows);
+      }
+      _loadOverlays(decoded['overlays']);
+      _loadMap(_remembered, decoded['remembered']);
+      final synced = decoded['synced'];
+      if (synced is int) {
+        _lastSync = DateTime.fromMillisecondsSinceEpoch(synced);
+      }
+      revision.value++;
+      _export();
+    } catch (_) {}
+  }
+
+  /// Copy names and numbers from the phone address book into FluffyChat.
+  static Future<int> syncFromPhone() async {
+    if (!PlatformInfos.isLinux) return 0;
+    final rows = await UtMedia.listContacts();
+    if (rows.isEmpty) {
+      throw Exception('Address book returned no contacts.');
+    }
+    _applyRows(rows);
+    if (_people == 0) {
+      throw Exception('Address book contacts had no phone numbers.');
+    }
+    _lastSync = DateTime.now();
+    _harvestPass = 0;
+    await _persist(contacts: _compact(rows));
+    revision.value++;
+    return _people;
+  }
+
+  /// Walk already-loaded room members for previous `+phone (WA)` labels
+  /// and remember MXID → contact name. In-memory only; no address-book I/O.
+  static void learnFromClient(Client client) {
+    if (!PlatformInfos.isLinux) return;
+    if (_names.isEmpty || client.rooms.isEmpty) return;
+    if (_harvestPass >= 2) return;
+    _harvestPass++;
+    var learned = false;
+    for (final room in client.rooms) {
+      for (final user in room.getParticipants()) {
+        if (_overlays.containsKey(user.id)) continue;
+        final hint = user.prevContent?.tryGet<String>('displayname');
+        if (hint == null || hint.isEmpty) continue;
+        final name = _lookup(hint);
+        if (name != null) {
+          _overlays[user.id] = name;
+          learned = true;
+          continue;
+        }
+        final current = user.displayName ?? '';
+        if (_looksLikePhone(current) && _isRealName(hint)) {
+          final real = _stripBridgeTag(hint);
+          if (_remembered[user.id] != real) {
+            _remembered[user.id] = real;
+            learned = true;
+          }
+        }
+      }
+    }
+    if (learned) {
+      _resolved.clear();
+      revision.value++;
+      _schedulePersist();
+    }
+  }
+
+  static String? localName(String mxid) => _overlays[mxid];
+
+  /// Persist a local MXID → name overlay. Empty [name] clears it.
+  static Future<void> assignName(String mxid, String name) async {
+    if (!PlatformInfos.isLinux) return;
+    final trimmed = name.trim();
+    if (trimmed.isEmpty) {
+      _overlays.remove(mxid);
+    } else {
+      _overlays[mxid] = _canonicalName(trimmed) ?? trimmed;
+    }
+    _resolved.clear();
+    await _persist();
+    revision.value++;
+  }
+
+  static String resolve(String display, {String? mxid, String? hint}) {
+    final id = mxid ?? display;
+    final overlay = mxid == null ? null : _overlays[mxid];
+    if (overlay != null) return overlay;
+
+    if (_names.isEmpty) return display;
+
+    final cached = _resolved[id];
+    if (cached != null) return cached;
+
+    String? found;
+    if (hint != null && hint.isNotEmpty) {
+      found = _lookup(hint);
+    }
+    if (found == null && _looksLikePhone(display)) {
+      found = _lookup(display);
+    }
+    found ??= _lookup(mxid);
+
+    if (found != null && mxid != null && _isLid(mxid) && hint != null) {
+      _overlays.putIfAbsent(mxid, () => found!);
+      _schedulePersist();
+    }
+
+    if (found == null && _looksLikePhone(display)) {
+      found = mxid == null ? null : _remembered[mxid];
+      if (found == null && hint != null && _isRealName(hint)) {
+        found = _stripBridgeTag(hint);
+        if (mxid != null) {
+          _remembered[mxid] = found;
+          _schedulePersist();
+        }
+      }
+    }
+
+    final result = found ?? display;
+    _resolved[id] = result;
+    return result;
+  }
+
+  static void _applyRows(List<dynamic> rows) {
+    _names.clear();
+    _resolved.clear();
+    var people = 0;
+    for (final row in rows) {
+      if (row is! Map) continue;
+      final name = (row['name'] ?? row['n']) as String?;
+      final phones = row['phones'] ?? row['p'];
+      if (name == null || name.isEmpty || phones is! List) continue;
+      var used = false;
+      for (final phone in phones) {
+        if (phone is! String) continue;
+        for (final key in _keys(phone)) {
+          _names.putIfAbsent(key, () => name);
+          used = true;
+        }
+      }
+      if (used) people++;
+    }
+    _people = people;
+  }
+
+  static void _loadOverlays(dynamic raw) => _loadMap(_overlays, raw);
+
+  static void _loadMap(Map<String, String> target, dynamic raw) {
+    target.clear();
+    if (raw is! Map) return;
+    raw.forEach((key, value) {
+      if (key is String &&
+          value is String &&
+          key.isNotEmpty &&
+          value.isNotEmpty) {
+        target[key] = value;
+      }
+    });
+  }
+
+  static List<Map<String, Object>> _compact(List<dynamic> rows) {
+    final compact = <Map<String, Object>>[];
+    for (final row in rows) {
+      if (row is! Map) continue;
+      final name = row['name'] as String?;
+      final phones = row['phones'];
+      if (name == null || name.isEmpty || phones is! List) continue;
+      final kept = phones.whereType<String>().where((p) => p.isNotEmpty);
+      if (kept.isEmpty) continue;
+      compact.add({'n': name, 'p': kept.toList()});
+    }
+    return compact;
+  }
+
+  static String? _canonicalName(String input) {
+    final lower = input.toLowerCase();
+    for (final name in _names.values) {
+      if (name.toLowerCase() == lower) return name;
+    }
+    return null;
+  }
+
+  static Future<void> _persist({List<Map<String, Object>>? contacts}) async {
+    final raw = AppSettings.store.getString(storeKey);
+    Map<String, dynamic> decoded = {};
+    if (raw != null && raw.isNotEmpty) {
+      try {
+        final value = jsonDecode(raw);
+        if (value is Map) {
+          decoded = Map<String, dynamic>.from(value);
+        }
+      } catch (_) {}
+    }
+    if (contacts != null) {
+      decoded['contacts'] = contacts;
+      if (_lastSync != null) {
+        decoded['synced'] = _lastSync!.millisecondsSinceEpoch;
+      }
+    }
+    if (_overlays.isEmpty) {
+      decoded.remove('overlays');
+    } else {
+      decoded['overlays'] = _overlays;
+    }
+    if (_remembered.isEmpty) {
+      decoded.remove('remembered');
+    } else {
+      decoded['remembered'] = _remembered;
+    }
+    await AppSettings.store.setString(storeKey, jsonEncode(decoded));
+    _export();
+  }
+
+  /// Number keys → name plus per-MXID names, for `push/push.cpp`. Keys
+  /// already include the suffix variants from [_keys], so the helper only
+  /// has to compute the same variants for the sender.
+  static void _export() {
+    final payload = jsonEncode({
+      'numbers': _names,
+      'users': _overlays,
+      'remembered': _remembered,
+    });
+    final dir = Directory(_cacheDir());
+    unawaited(() async {
+      try {
+        await dir.create(recursive: true);
+        final tmp = File('${dir.path}/$exportFileName.tmp');
+        await tmp.writeAsString(payload, flush: true);
+        await tmp.rename('${dir.path}/$exportFileName');
+      } catch (e) {
+        Logs().w('ContactBook: cannot export names for the push helper', e);
+      }
+    }());
+  }
+
+  static String _cacheDir() {
+    final xdg = Platform.environment['XDG_CACHE_HOME'];
+    if (xdg != null && xdg.isNotEmpty) {
+      return xdg.endsWith('fluffychat.notkit')
+          ? xdg
+          : '$xdg/fluffychat.notkit';
+    }
+    final home = Platform.environment['HOME'] ?? '/home/phablet';
+    return '$home/.cache/fluffychat.notkit';
+  }
+
+  static bool _isRealName(String value) {
+    final name = _stripBridgeTag(value);
+    return name.isNotEmpty &&
+        !_looksLikePhone(name) &&
+        !_isLid(name) &&
+        _letter.hasMatch(name);
+  }
+
+  static String _stripBridgeTag(String value) =>
+      value.replaceFirst(_bridgeTag, '').trim();
+
+  static void _schedulePersist() {
+    if (_persistScheduled) return;
+    _persistScheduled = true;
+    Future.microtask(() async {
+      _persistScheduled = false;
+      await _persist();
+    });
+  }
+
+  static bool _isLid(String value) {
+    final lower = value.toLowerCase();
+    return lower.contains('whatsapp_lid') || lower.contains('_lid-');
+  }
+
+  static bool _looksLikePhone(String value) {
+    final trimmed = value.trim();
+    if (trimmed.isEmpty || _isLid(trimmed)) return false;
+    final digits = trimmed.replaceAll(_nonDigit, '');
+    // Bridge labels like "+265881522266 (WA)" still count as numbers.
+    if (digits.length >= 7) return true;
+    final lower = trimmed.toLowerCase();
+    for (final prefix in _bridgePrefixes) {
+      if (lower.contains(prefix)) return true;
+    }
+    return false;
+  }
+
+  static String? _lookup(String? value) {
+    if (value == null || value.isEmpty) return null;
+    for (final key in _keys(value)) {
+      final name = _names[key];
+      if (name != null) return name;
+    }
+    return null;
+  }
+
+  static Iterable<String> _keys(String raw) sync* {
+    var text = raw.toLowerCase();
+    final at = text.indexOf(':');
+    if (text.startsWith('@') && at > 0) {
+      text = text.substring(1, at);
+    }
+    for (final prefix in _bridgePrefixes) {
+      if (text.startsWith(prefix)) {
+        text = text.substring(prefix.length);
+        break;
+      }
+    }
+    // WhatsApp LID ghost ids are not phone numbers.
+    if (text.startsWith('lid')) return;
+    final digits = text.replaceAll(_nonDigit, '');
+    if (digits.length < 7) return;
+    yield digits;
+    final stripped = digits.replaceFirst(_leadingZeros, '');
+    if (stripped.length >= 7 && stripped != digits) yield stripped;
+    if (digits.length > 10) yield digits.substring(digits.length - 10);
+    if (digits.length > 9) yield digits.substring(digits.length - 9);
+    if (digits.length > 8) yield digits.substring(digits.length - 8);
+    if (stripped.length > 9) yield stripped.substring(stripped.length - 9);
+    if (stripped.length > 8) yield stripped.substring(stripped.length - 8);
+  }
+}
+
+extension ContactRoomName on Room {
