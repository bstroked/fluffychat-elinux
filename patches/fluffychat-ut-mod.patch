+    calcDisplayname(),
+    mxid: id,
+    hint: prevContent?.tryGet<String>('displayname'),
+  );
+}
+
+/// The SDK builds previews and notification text with the bridge's sender
+/// name ("+1555… (WA): hi", "+1555… sent a picture"). Swap in the
+/// ContactBook name for the first occurrence.
+extension ContactEventBody on Event {
+  Future<String> uiLocalizedBody(
+    MatrixLocalizations i18n, {
+    bool withSenderNamePrefix = false,
+    bool hideReply = false,
+    bool hideEdit = false,
+    bool plaintextBody = false,
+    bool removeMarkdown = false,
+  }) async {
+    final body = await calcLocalizedBody(
+      i18n,
+      withSenderNamePrefix: withSenderNamePrefix,
+      hideReply: hideReply,
+      hideEdit: hideEdit,
+      plaintextBody: plaintextBody,
+      removeMarkdown: removeMarkdown,
+    );
+    return _withContactSender(body, i18n);
+  }
+
+  String uiLocalizedBodyFallback(
+    MatrixLocalizations i18n, {
+    bool withSenderNamePrefix = false,
+    bool hideReply = false,
+    bool hideEdit = false,
+    bool plaintextBody = false,
+    bool removeMarkdown = false,
+  }) => _withContactSender(
+    calcLocalizedBodyFallback(
+      i18n,
+      withSenderNamePrefix: withSenderNamePrefix,
+      hideReply: hideReply,
+      hideEdit: hideEdit,
+      plaintextBody: plaintextBody,
+      removeMarkdown: removeMarkdown,
+    ),
+    i18n,
+  );
+
+  String _withContactSender(String body, MatrixLocalizations i18n) {
+    if (senderId == room.client.userID) return body;
+    final sender = senderFromMemoryOrFallback;
+    final raw = sender.calcDisplayname(i18n: i18n);
+    final shown = sender.uiDisplayname();
+    if (raw.isEmpty || raw == shown) return body;
+    return body.replaceFirst(raw, shown);
+  }
+}
