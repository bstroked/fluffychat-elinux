diff --git a/lib/widgets/bottom_back_gesture.dart b/lib/widgets/bottom_back_gesture.dart
new file mode 100644
index 000000000..f0c5e977a
--- /dev/null
+++ b/lib/widgets/bottom_back_gesture.dart
@@ -0,0 +1,97 @@
+import 'package:fluffychat/utils/platform_infos.dart';
+import 'package:fluffychat/widgets/fluffy_chat_app.dart';
+import 'package:flutter/material.dart';
+import 'package:ut_media/ut_media.dart';
+
+/// Cinny-style swipe-up-from-bottom to go back, for Ubuntu Touch.
+///
+/// Cinny uses Lomiri SwipeArea (2 GU, physical 0.5 inch). Flutter cannot use
+/// that compositor gesture, so this overlay sits a bit taller than the shell
+/// edge grab and listens for pointer motion directly.
+class BottomBackGesture extends StatefulWidget {
+  const BottomBackGesture({super.key});
+
+  @override
+  State<BottomBackGesture> createState() => _BottomBackGestureState();
+}
+
+class _BottomBackGestureState extends State<BottomBackGesture> {
+  double _drag = 0;
+  int? _pointer;
+  static const _trigger = 36.0;
+  static const _height = 56.0;
+
+  void _goBack() {
+    final router = FluffyChatApp.router;
+    if (router.canPop()) {
+      router.pop();
+      return;
+    }
+    final path = router.routerDelegate.currentConfiguration.uri.path;
+    if (path == '/' || path == '/rooms' || path == '/home') return;
+    if (path.startsWith('/rooms/')) {
+      final parts = path.split('/');
+      if (parts.length > 3) {
+        router.go(parts.sublist(0, parts.length - 1).join('/'));
+      } else {
+        router.go('/rooms');
+      }
+      return;
+    }
+    if (path.startsWith('/home/')) {
+      router.go('/home');
+      return;
+    }
+    router.go('/rooms');
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    if (!PlatformInfos.isLinux) return const SizedBox.shrink();
+    final theme = Theme.of(context);
+    return Positioned(
+      left: 0,
+      right: 0,
+      bottom: 0,
+      height: _height,
+      child: Listener(
+        behavior: HitTestBehavior.translucent,
+        onPointerDown: (event) {
+          _pointer = event.pointer;
+          _drag = 0;
+          UtMedia.haptic();
+        },
+        onPointerMove: (event) {
+          if (event.pointer != _pointer) return;
+          setState(() => _drag -= event.delta.dy);
+        },
+        onPointerUp: (event) {
+          if (event.pointer != _pointer) return;
+          _pointer = null;
+          if (_drag > _trigger) _goBack();
+          setState(() => _drag = 0);
+        },
+        onPointerCancel: (_) {
+          _pointer = null;
+          setState(() => _drag = 0);
+        },
+        child: Align(
+          alignment: Alignment.bottomCenter,
+          child: AnimatedOpacity(
+            duration: const Duration(milliseconds: 120),
+            opacity: _drag > 8 ? 1 : 0.45,
+            child: Container(
+              margin: const EdgeInsets.only(bottom: 10),
+              width: 108,
+              height: 5,
+              decoration: BoxDecoration(
+                color: theme.colorScheme.onSurface.withAlpha(110),
+                borderRadius: BorderRadius.circular(3),
+              ),
+            ),
+          ),
+        ),
+      ),
+    );
+  }
+}
