+    }
+
+    // tmpfs: gone after reboot, so a crashed session cannot mute the helper.
+    add(_lomiriRuntimeDir());
+    // Helper and app confinement may not share XDG_RUNTIME_DIR; cache is the
+    // path both already use. Fresh mtime (not fcntl) is the foreground check:
+    // recents SIGSTOP leaves an fcntl lock held forever.
+    add(_lomiriCacheDir());
+    return dirs;
+  }
+
+  /// Heartbeat the push helper can see. Refreshed every second while this
+  /// isolate is [AppLifecycleState.resumed]. Recents SIGSTOP's the process
+  /// before Dart can release an fcntl lock, so a stale mtime means "not
+  /// foreground" and the helper must still post.
+  Future<void> setLomiriForeground(bool foreground) async {
+    if (!PlatformInfos.isLinux) return;
+    if (foreground) {
+      await _startLomiriHeartbeat();
+    } else {
+      await _stopLomiriHeartbeat();
+    }
+  }
+
+  Future<void> _startLomiriHeartbeat() async {
+    await _ensureLomiriHeartbeatFiles();
+    await _writeLomiriHeartbeat();
+    _lomiriHeartbeat ??= Timer.periodic(
+      _lomiriHeartbeatInterval,
+      (_) => unawaited(_writeLomiriHeartbeat()),
+    );
+  }
+
+  Future<void> _ensureLomiriHeartbeatFiles() async {
+    if (_lomiriHeartbeatFiles.isNotEmpty) return;
+    for (final dirPath in _lomiriForegroundLockDirs()) {
+      try {
+        final dir = Directory(dirPath);
+        if (!await dir.exists()) {
+          await dir.create(recursive: true);
+        }
+        try {
+          await File('${dir.path}/running.lock').delete();
+        } catch (_) {}
+        _lomiriHeartbeatFiles.add(File('${dir.path}/foreground.lock'));
+      } catch (e) {
+        Logs().w('[Push] Unable to prepare heartbeat in $dirPath', e);
+      }
+    }
+    if (_lomiriHeartbeatFiles.isNotEmpty) {
+      DiagnosticTrace.setHeartbeat(true);
+      Logs().i('[Push] Started foreground heartbeat');
+    }
+  }
+
+  Future<void> _writeLomiriHeartbeat() async {
+    final payload = '$pid\n${DateTime.now().millisecondsSinceEpoch}\n';
+    for (final file in _lomiriHeartbeatFiles) {
+      try {
+        await file.writeAsString(payload, flush: true);
+      } catch (e) {
+        Logs().w('[Push] Unable to write heartbeat ${file.path}', e);
+      }
+    }
+  }
+
+  Future<void> _stopLomiriHeartbeat() async {
+    DiagnosticTrace.setHeartbeat(false);
+    _lomiriHeartbeat?.cancel();
+    _lomiriHeartbeat = null;
+    final files = List<File>.from(_lomiriHeartbeatFiles);
+    _lomiriHeartbeatFiles.clear();
+    if (files.isEmpty) return;
+    for (final file in files) {
+      try {
+        await file.delete();
+      } catch (_) {}
+    }
+    Logs().i('[Push] Stopped foreground heartbeat');
+  }
+
+  void _watchLomiriForegroundLock() {
+    if (_lomiriLifecycle != null) return;
+    _lomiriLifecycle = AppLifecycleListener(
+      onStateChange: (state) {
+        unawaited(setLomiriForeground(state == AppLifecycleState.resumed));
+      },
+    );
+    // Null lifecycleState means the first platform event has not landed yet.
+    // The GUI is starting, so heartbeat until we know we are not resumed.
+    // Recents SIGSTOP never delivers paused, so this must not wait on it.
+    final state = WidgetsBinding.instance.lifecycleState;
+    unawaited(
+      setLomiriForeground(
+        state == null || state == AppLifecycleState.resumed,
+      ),
+    );
+  }
+
+  /// Ubuntu Touch push: lomiri-push-service hands out a token identifying this
+  /// user+device for our click package, and UBports runs a Matrix push gateway
+  /// that relays notifications into the device's push connection. The click's
+  /// push helper turns each payload into a notification, so nothing has to run
+  /// in the background on our side.
+  Future<void> _setupLomiriPush() async {
+    if (matrix == null) return;
+
+    final token = _lomiriPushToken ??= await LomiriPushClient.register();
+    if (token == null) {
+      Logs().w('[Push] Unable to obtain a Lomiri push token');
+      return;
+    }
+    // Info level so this is visible without raising Logs().level; the token
+    // itself is a pushkey, so log only that we have one.
+    Logs().i('[Push] Lomiri push token acquired, registering pusher');
+
+    for (final client in clients) {
+      if (client.onLoginStateChanged.value != LoginState.loggedIn) continue;
+      Logs().d('[Push] SetupPush for Client ${client.clientName}');
+      await setupPusher(
+        client: client,
+        gatewayUrl: LomiriPushClient.gatewayUrl,
+        token: token,
+      );
+    }
+  }
+
+  int _lomiriBadgeCount = -1;
+  final Set<String> _lomiriNotifiedRooms = {};
+  final List<StreamSubscription> _lomiriSubs = [];
+
+  /// The push helper writes the launcher counter and the notification bubbles
+  /// while the app is closed, and has no way to know they were dealt with
+  /// afterwards. Keep both in step with the real unread state instead.
+  void _watchLomiriNotifications() {
+    if (_lomiriSubs.isNotEmpty) return;
+    for (final client in clients) {
+      _lomiriSubs.add(client.onSync.stream.listen((_) => _syncLomiriState()));
+    }
+    _syncLomiriState();
+  }
+
+  Future<void> _syncLomiriState() async {
+    var total = 0;
+    final read = <String>[];
+    for (final client in clients) {
+      for (final room in client.rooms) {
+        final count = room.notificationCount;
+        total += count;
+        if (count > 0) {
+          _lomiriNotifiedRooms.add(room.id);
+        } else if (_lomiriNotifiedRooms.remove(room.id)) {
+          read.add(room.id);
+        }
+      }
+    }
+
+    if (total != _lomiriBadgeCount) {
+      _lomiriBadgeCount = total;
+      await LomiriPushClient.setCounter(total);
+    }
+    // The helper tags each card with its room id, so a read room's bubbles can
+    // be dismissed without touching the others.
+    if (read.isNotEmpty) await LomiriPushClient.clearPersistent(read);
+  }
+
+  /// Handles a notification tap that cold-started the app. The url-dispatcher
+  /// passes the card's `fluffychat://<room_id>` action through the desktop
+  /// file's %U, so it arrives in our argv. Read it from /proc/self/cmdline,
+  /// which needs no extra platform channel.
+  ///
+  /// Only covers a cold start: Lomiri delivers URLs to an already-running app
+  /// over a Qt-only channel that a Flutter app cannot receive, so tapping a
+  /// notification while the app is open just focuses it.
+  Future<void> _handleLomiriLaunchUrl() async {
+    if (_wentToRoomOnStartup) return;
+
+    const prefix = 'fluffychat://';
+    String? roomId;
+    try {
+      final cmdline = await File('/proc/self/cmdline').readAsString();
+      for (final arg in cmdline.split('\x00')) {
+        if (arg.startsWith(prefix) && arg.length > prefix.length) {
+          roomId = arg.substring(prefix.length);
+          break;
+        }
+      }
+    } catch (e) {
+      Logs().w('[Push] Unable to read /proc/self/cmdline', e);
+      return;
+    }
+    if (roomId == null) return;
+
+    Logs().v('[Push] Open room from notification tap', roomId);
+    for (final client in clients) {
+      await client.roomsLoading;
+      await client.accountDataLoading;
+      final room = client.getRoomById(roomId);
+      if (room == null) continue;
+      _wentToRoomOnStartup = true;
+      FluffyChatApp.router.go(
+        room.membership == Membership.invite
+            ? '/rooms?client=${client.clientName}'
+            : '/rooms/$roomId?client=${client.clientName}',
+      );
+      return;
+    }
+    Logs().w('[Push] Room from notification tap not found', roomId);
+  }
