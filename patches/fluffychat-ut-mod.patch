+
+/// Content-hub type for handing [event]'s attachment to another app.
+String contentHubTypeForEvent(Event event) {
+  final mime =
+      event.content
+          .tryGetMap<String, Object?>('info')
+          ?.tryGet<String>('mimetype')
+          ?.toLowerCase() ??
+      '';
+  final name =
+      (event.content.tryGet<String>('filename') ?? event.body).toLowerCase();
+
+  if (mime.startsWith('video/') ||
+      name.endsWith('.mp4') ||
+      name.endsWith('.webm') ||
+      name.endsWith('.mkv')) {
+    return 'videos';
+  }
+  if (mime.startsWith('audio/') ||
+      name.endsWith('.ogg') ||
+      name.endsWith('.opus') ||
+      name.endsWith('.mp3') ||
+      name.endsWith('.m4a')) {
+    return 'music';
+  }
+  if (mime.startsWith('image/')) {
+    return 'pictures';
+  }
+  if (mime == 'application/pdf' ||
+      mime.contains('document') ||
+      mime.contains('msword') ||
+      mime.contains('opendocument') ||
+      mime.contains('spreadsheet') ||
+      mime.contains('presentation') ||
+      name.endsWith('.pdf') ||
+      name.endsWith('.odt') ||
+      name.endsWith('.ods') ||
+      name.endsWith('.odp') ||
+      name.endsWith('.doc') ||
+      name.endsWith('.docx') ||
+      name.endsWith('.xls') ||
+      name.endsWith('.xlsx') ||
+      name.endsWith('.ppt') ||
+      name.endsWith('.pptx')) {
+    return 'documents';
+  }
+  return 'all';
+}
+
+/// Downloads/decrypts [event]'s attachment and exports it via content-hub.
+///
+/// Used on Ubuntu Touch where there is no in-app viewer for videos/PDFs/files.
+Future<void> openAttachmentWithSystemApp(
+  BuildContext context,
+  Event event, {
+  String? contentType,
+}) async {
+  final result = await showFutureLoadingDialog<MatrixFile>(
+    context: context,
+    futureWithProgress: (onProgress) {
+      final fileSize = event.infoMap['size'] is int
+          ? event.infoMap['size'] as int
+          : null;
+      return event.downloadAndDecryptAttachment(
+        onDownloadProgress: fileSize == null
+            ? null
+            : (bytes) => onProgress(bytes / fileSize),
+      );
+    },
+  );
+  final matrixFile = result.result;
+  if (matrixFile == null || !context.mounted) return;
+
+  final cache = Directory(
+    Platform.environment['XDG_CACHE_HOME'] ??
+        '${Platform.environment['HOME'] ?? '/tmp'}/.cache/fluffychat.notkit',
+  );
+  await cache.create(recursive: true);
+  final safeName = matrixFile.name.replaceAll(RegExp(r'[/\\]'), '_');
+  final file = File('${cache.path}/${event.eventId}_$safeName');
+  await file.writeAsBytes(matrixFile.bytes, flush: true);
+
+  final preferred = contentType ?? contentHubTypeForEvent(event);
+  var opened = await ContentHubFilePickerPlugin.openWith(
+    file.path,
+    contentType: preferred,
+  );
+  // Prefer documents for PDFs/office, but fall back to "all" if no peer
+  // registered for that type.
+  if (opened == false && preferred == 'documents') {
+    opened = await ContentHubFilePickerPlugin.openWith(
+      file.path,
+      contentType: 'all',
+    );
+  }
+  if (!context.mounted || opened != false) return;
+  ScaffoldMessenger.of(context).showSnackBar(
+    const SnackBar(content: Text('No app can open this file')),
+  );
+}
