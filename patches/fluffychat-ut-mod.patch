diff --git a/lib/widgets/bottom_back_gesture.dart b/lib/widgets/bottom_back_gesture.dart
new file mode 100644
index 000000000..3ad2f38e2
--- /dev/null
+++ b/lib/widgets/bottom_back_gesture.dart
@@ -0,0 +1,83 @@
+import 'package:fluffychat/utils/platform_infos.dart';
+import 'package:flutter/material.dart';
+import 'package:go_router/go_router.dart';
+import 'package:ut_media/ut_media.dart';
+
+/// Cinny-style swipe-up-from-bottom to go back, for Ubuntu Touch.
+class BottomBackGesture extends StatefulWidget {
+  const BottomBackGesture({super.key});
+
+  @override
+  State<BottomBackGesture> createState() => _BottomBackGestureState();
+}
+
+class _BottomBackGestureState extends State<BottomBackGesture> {
+  double _drag = 0;
+  static const _trigger = 48.0;
+
+  void _goBack(BuildContext context) {
+    final router = GoRouter.of(context);
+    if (router.canPop()) {
+      router.pop();
+      return;
+    }
+    final path = router.routerDelegate.currentConfiguration.uri.path;
+    if (path == '/' || path == '/rooms' || path == '/home') return;
+    if (path.startsWith('/rooms/')) {
+      final parts = path.split('/');
+      if (parts.length > 3) {
+        router.go(parts.sublist(0, parts.length - 1).join('/'));
+      } else {
+        router.go('/rooms');
+      }
+      return;
+    }
+    if (path.startsWith('/home/')) {
+      router.go('/home');
+      return;
+    }
+    router.go('/rooms');
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    if (!PlatformInfos.isLinux) return const SizedBox.shrink();
+    final theme = Theme.of(context);
+    return Positioned(
+      left: 0,
+      right: 0,
+      bottom: 0,
+      height: 28,
+      child: GestureDetector(
+        behavior: HitTestBehavior.translucent,
+        onVerticalDragStart: (_) {
+          UtMedia.haptic();
+          setState(() => _drag = 0);
+        },
+        onVerticalDragUpdate: (details) {
+          setState(() => _drag -= details.delta.dy);
+        },
+        onVerticalDragEnd: (_) {
+          if (_drag > _trigger) _goBack(context);
+          setState(() => _drag = 0);
+        },
+        child: Align(
+          alignment: Alignment.bottomCenter,
+          child: AnimatedOpacity(
+            duration: const Duration(milliseconds: 120),
+            opacity: _drag > 8 ? 1 : 0.55,
+            child: Container(
+              margin: const EdgeInsets.only(bottom: 8),
+              width: 96,
+              height: 4,
+              decoration: BoxDecoration(
+                color: theme.colorScheme.onSurface.withAlpha(90),
+                borderRadius: BorderRadius.circular(2),
+              ),
+            ),
+          ),
+        ),
+      ),
+    );
+  }
+}
