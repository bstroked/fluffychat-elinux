diff --git a/lib/utils/diagnostic_trace.dart b/lib/utils/diagnostic_trace.dart
new file mode 100644
index 000000000..85eb16430
--- /dev/null
+++ b/lib/utils/diagnostic_trace.dart
@@ -0,0 +1,321 @@
+import 'dart:async';
+import 'dart:convert';
+import 'dart:typed_data';
+
+import 'package:fluffychat/config/setting_keys.dart';
+import 'package:fluffychat/utils/platform_infos.dart';
+import 'package:flutter/widgets.dart';
+import 'package:matrix/matrix.dart';
+
+/// Ring buffer for the three Ubuntu Touch notification failures, plus a
+/// snapshot of why the app is idle at the moment the sidebar icon is pressed.
+class DiagnosticTrace {
+  DiagnosticTrace._();
+
+  static const _maxLines = 400;
+  static final List<String> _lines = <String>[];
+  static final Map<String, StreamSubscription<SyncStatusUpdate>> _subs = {};
+
+  static DateTime? _statusSince;
+  static SyncStatus? _status;
+  static String? _lastError;
+  static DateTime? _lastErrorAt;
+  static DateTime? _lastWaitingAt;
+  static DateTime? _lastFinishedAt;
+  static DateTime? _lastResumeAt;
+  static bool? _backgroundSync;
+  static AppLifecycleState? _lifecycle;
+  static bool _heartbeat = false;
+  static int _eventsSinceFinish = 0;
+  static int _playedSinceFinish = 0;
+  static final Map<String, String> _lastDecision = {};
+
+  static bool get heartbeatRunning => _heartbeat;
+
+  static void watch(Client client) {
+    if (_subs.containsKey(client.clientName)) return;
+    _subs[client.clientName] = client.onSyncStatus.stream.listen(
+      (update) => _onStatus(client, update),
+    );
+  }
+
+  static void unwatch(String clientName) {
+    _subs.remove(clientName)?.cancel();
+  }
+
+  static void setHeartbeat(bool running) {
+    if (_heartbeat == running) return;
+    _heartbeat = running;
+    add(
+      running
+          ? 'foreground heartbeat started; push helper muted'
+          : 'foreground heartbeat stopped; push helper may post',
+    );
+  }
+
+  static void lifecycle({
+    required AppLifecycleState state,
+    required bool backgroundSync,
+  }) {
+    final alreadyResumed =
+        _lifecycle == AppLifecycleState.resumed &&
+        state == AppLifecycleState.resumed;
+    _lifecycle = state;
+    _backgroundSync = backgroundSync;
+    if (state == AppLifecycleState.resumed) {
+      _lastResumeAt = DateTime.now();
+      add(
+        'lifecycle resumed${alreadyResumed ? ' while already resumed' : ''}, '
+        'cutoff moved, backgroundSync=$backgroundSync',
+      );
+    } else {
+      add('lifecycle ${state.name}, backgroundSync=$backgroundSync');
+    }
+  }
+
+  static void chime({
+    required String roomId,
+    required String eventId,
+    required String decision,
+    String? detail,
+  }) {
+    _eventsSinceFinish++;
+    if (decision == 'played') _playedSinceFinish++;
+    _lastDecision[roomId] = detail == null ? decision : '$decision $detail';
+    add(
+      'chime $decision room=$roomId event=$eventId'
+      '${detail == null ? '' : ' $detail'}',
+    );
+  }
+
+  static void add(String message) {
+    final line = _scrub(message);
+    if (line.toLowerCase().contains('access_token')) return;
+    _lines.add('${DateTime.now().toIso8601String()} $line');
+    if (_lines.length > _maxLines) {
+      _lines.removeRange(0, _lines.length - _maxLines);
+    }
+  }
+
+  static Future<void> send({
+    required Client client,
+    required DateTime resumeCutoff,
+  }) async {
+    final roomId = AppSettings.diagnosticLogRoomId.value.trim();
+    if (roomId.isEmpty) {
+      throw Exception('No diagnostic room chosen');
+    }
+    final room = client.getRoomById(roomId);
+    if (room == null) {
+      throw Exception('Diagnostic room is not joined: $roomId');
+    }
+    final version = await PlatformInfos.getVersion();
+    final text = buildReport(
+      client: client,
+      version: version,
+      resumeCutoff: resumeCutoff,
+    );
+    final stamp = DateTime.now()
+        .toIso8601String()
+        .replaceAll(':', '-')
+        .replaceAll('.', '-');
+    await room.sendFileEvent(
+      MatrixFile(
+        bytes: Uint8List.fromList(utf8.encode(text)),
+        name: 'fluffychat-diagnostics-$stamp.txt',
+      ),
+    );
+    await room.sendTextEvent('Diagnostic logs $version');
+  }
+
+  static String buildReport({
+    required Client client,
+    required String version,
+    required DateTime resumeCutoff,
+  }) {
+    final now = DateTime.now();
+    final status = client.onSyncStatus.value?.status ?? _status;
+    final statusAge = _statusSince == null
+        ? null
+        : now.difference(_statusSince!).inSeconds;
+    final sinceFinished = _lastFinishedAt == null
+        ? null
+        : now.difference(_lastFinishedAt!).inSeconds;
+    final sinceResume = _lastResumeAt == null
+        ? null
+        : now.difference(_lastResumeAt!).inSeconds;
+    final liveLifecycle =
+        WidgetsBinding.instance.lifecycleState?.name ?? 'unknown';
+    final unread = client.rooms
+        .where((room) => !room.isSpace && room.notificationCount > 0)
+        .toList();
+    final idle = _idleReason(
+      status: status,
+      statusAge: statusAge,
+      unread: unread,
+    );
+
+    final buffer = StringBuffer()
+      ..writeln('Diagnostic logs $version')
+      ..writeln('time: ${now.toIso8601String()}')
+      ..writeln('--- right now ---')
+      ..writeln('idle: $idle')
+      ..writeln('lifecycle: $liveLifecycle')
+      ..writeln(
+        'backgroundSync: ${_backgroundSync == null ? 'unknown' : _backgroundSync}',
+      )
+      ..writeln(
+        'syncStatus: ${status?.name ?? 'none'}'
+        '${statusAge == null ? '' : ' unchanged for ${statusAge}s'}',
+      )
+      ..writeln('syncPending: ${client.syncPending}')
+      ..writeln(
+        'seconds since last finished sync: ${sinceFinished ?? 'never'}',
+      )
+      ..writeln('last sync error: ${_lastError ?? 'none'}')
+      ..writeln(
+        'heartbeat: ${_heartbeat ? 'running (push helper muted)' : 'stopped'}',
+      )
+      ..writeln(
+        'resume cutoff: ${resumeCutoff.toIso8601String()}'
+        '${sinceResume == null ? '' : ' (${sinceResume}s ago)'}',
+      )
+      ..writeln(
+        'notification events since last finished sync: $_eventsSinceFinish '
+        'played: $_playedSinceFinish',
+      );
+    if (unread.isEmpty) {
+      buffer.writeln('unread: none');
+    } else {
+      buffer.writeln('unread:');
+      for (final room in unread) {
+        final decision = _lastDecision[room.id] ?? 'no notification decision';
+        buffer.writeln(
+          '  ${room.id} count=${room.notificationCount} last=$decision',
+        );
+      }
+    }
+    buffer.writeln('--- trace ---');
+    if (_lines.isEmpty) {
+      buffer.writeln('(no trace yet)');
+    } else {
+      for (final line in _lines) {
+        buffer.writeln(line);
+      }
+    }
+    return buffer.toString();
+  }
+
+  static String _idleReason({
+    required SyncStatus? status,
+    required int? statusAge,
+    required List<Room> unread,
+  }) {
+    if (status == SyncStatus.error) {
+      return 'sync error'
+          '${statusAge == null ? '' : ' for ${statusAge}s'}'
+          ': ${_lastError ?? 'unknown'}';
+    }
+    if (status == SyncStatus.waitingForResponse &&
+        statusAge != null &&
+        statusAge >= 5) {
+      return 'sync still waitingForResponse for ${statusAge}s; '
+          'the room list has not moved';
+    }
+    final skipped = unread.where(
+      (room) =>
+          (_lastDecision[room.id] ?? '').startsWith('skipped-older-than-resume'),
+    );
+    if (unread.isNotEmpty && skipped.length == unread.length) {
+      return 'unread messages were skipped because they are older than this open';
+    }
+    if (_heartbeat && _playedSinceFinish == 0) {
+      return 'foreground heartbeat is running so the push helper is silent, '
+          'and no in-app chime has played since the last finished sync';
+    }
+    final muted = _heartbeat ? 'muted' : 'not muted';
+    return 'sync is ${status?.name ?? 'unknown'}, helper is $muted, '
+        'and no notification was attempted since the last finished sync';
+  }
+
+  static void _onStatus(Client client, SyncStatusUpdate update) {
+    final now = DateTime.now();
+    final sincePrev = _statusSince == null
+        ? 0
+        : now.difference(_statusSince!).inSeconds;
+    final anchor = _later(_lastErrorAt, _lastWaitingAt);
+    final sinceAnchor = anchor == null ? 0 : now.difference(anchor).inSeconds;
+    final timing =
+        '${sincePrev}s since previous, ${sinceAnchor}s since last error or waitingForResponse';
+    _status = update.status;
+    _statusSince = now;
+
+    if (update.status == SyncStatus.error) {
+      _lastError = _scrub(_shortError(update.error));
+      _lastErrorAt = now;
+      add('sync error ($timing): $_lastError');
+      return;
+    }
+    if (update.status == SyncStatus.waitingForResponse) {
+      _lastWaitingAt = now;
+      add('sync waitingForResponse ($timing)');
+      return;
+    }
+    if (update.status == SyncStatus.finished) {
+      final sinceResume = _lastResumeAt == null
+          ? null
+          : now.difference(_lastResumeAt!).inSeconds;
+      final sinceError = _lastErrorAt == null
+          ? null
+          : now.difference(_lastErrorAt!).inSeconds;
+      final unread = client.rooms
+          .where((room) => !room.isSpace && room.notificationCount > 0)
+          .length;
+      _lastFinishedAt = now;
+      add(
+        'sync finished ($timing)'
+        '${sinceResume == null ? '' : ', ${sinceResume}s since resume'}'
+        '${sinceError == null ? '' : ', ${sinceError}s since last error'}'
+        '; unreadRooms=$unread notificationEvents=$_eventsSinceFinish '
+        'played=$_playedSinceFinish',
+      );
+      if (unread > 0 && _eventsSinceFinish == 0) {
+        add('sync finished with unread rooms and zero notification events');
+      }
+      _eventsSinceFinish = 0;
+      _playedSinceFinish = 0;
+      return;
+    }
+    add('sync ${update.status.name} ($timing)');
+  }
+
+  static DateTime? _later(DateTime? a, DateTime? b) {
+    if (a == null) return b;
+    if (b == null) return a;
+    return a.isAfter(b) ? a : b;
+  }
+
+  static String _shortError(SdkError? error) {
+    final exception = error?.exception;
+    if (exception == null) return 'unknown';
+    final described = exception is SyncConnectionException
+        ? 'SyncConnectionException: ${exception.originalException}'
+        : exception.toString();
+    final raw = described.replaceAll('\n', ' ');
+    if (raw.toLowerCase().contains('access_token') || raw.contains('syt_')) {
+      return exception.runtimeType.toString();
+    }
+    if (raw.length <= 240) return raw;
+    return '${raw.substring(0, 240)} (${exception.runtimeType})';
+  }
+
+  static String _scrub(String message) {
+    return message
+        .replaceAll(
+          RegExp(r'access_token=[^&\s]+'),
+          'access_token=[redacted]',
+        )
+        .replaceAll(RegExp(r'syt_[A-Za-z0-9_]+'), 'syt_[redacted]')
+        .replaceAll(RegExp(r'Bearer [A-Za-z0-9._\-]+'), 'Bearer [redacted]');
+  }
+}
