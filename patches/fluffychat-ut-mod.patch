new file mode 100644
index 000000000..a3a74b9a1
--- /dev/null
+++ b/lib/pages/chat_list/diagnostic_log_button.dart
@@ -0,0 +1,223 @@
+import 'package:fluffychat/config/setting_keys.dart';
+import 'package:fluffychat/l10n/l10n.dart';
+import 'package:fluffychat/utils/adaptive_bottom_sheet.dart';
+import 'package:fluffychat/utils/contact_book.dart';
+import 'package:fluffychat/utils/diagnostic_trace.dart';
+import 'package:fluffychat/utils/matrix_sdk_extensions/matrix_locals.dart';
+import 'package:fluffychat/utils/sync_recovery.dart';
+import 'package:fluffychat/widgets/future_loading_dialog.dart';
+import 'package:fluffychat/widgets/matrix.dart';
+import 'package:flutter/material.dart';
+import 'package:matrix/matrix.dart';
+
+/// Re-registers the Lomiri pusher and drops a stuck /sync so messages and
+/// alerts can start again. The push helper process itself is started by
+/// lomiri-push-service when a push arrives; this only re-arms that path.
+class NotifierRestartButton extends StatelessWidget {
+  const NotifierRestartButton({super.key});
+
+  @override
+  Widget build(BuildContext context) {
+    final theme = Theme.of(context);
+    return IconButton(
+      visualDensity: VisualDensity.compact,
+      iconSize: 20,
+      color: theme.colorScheme.onSurfaceVariant,
+      tooltip: 'Restart notifier',
+      onPressed: () => _restart(context),
+      icon: const Icon(Icons.notifications_active_outlined),
+    );
+  }
+
+  static Future<void> _restart(BuildContext context) async {
+    final matrix = Matrix.of(context);
+    final result = await showFutureLoadingDialog(
+      context: context,
+      future: () async {
+        DiagnosticTrace.add('notifier restart requested');
+        await matrix.backgroundPush?.restartLomiriNotifier();
+        await SyncRecovery.onResumed(matrix.widget.clients, rearm: false);
+      },
+    );
+    if (!context.mounted) return;
+    final failed = result.isError;
+    ScaffoldMessenger.of(context).showSnackBar(
+      SnackBar(
+        content: Text(
+          failed ? 'Notifier restart failed' : 'Notifier restarted',
+        ),
+      ),
+    );
+  }
+}
+
+/// Small icon at the bottom of the left sidebar. A tap sends the diagnostic
+/// report when a room is saved; otherwise, and on long-press, it asks which
+/// room to use and confirms the first send.
+class DiagnosticLogButton extends StatelessWidget {
+  const DiagnosticLogButton({super.key});
+
+  @override
+  Widget build(BuildContext context) {
+    final theme = Theme.of(context);
+    return Padding(
+      padding: const EdgeInsets.only(bottom: 8),
+      child: IconButton(
+        visualDensity: VisualDensity.compact,
+        iconSize: 20,
+        color: theme.colorScheme.onSurfaceVariant,
+        onPressed: () => _onTap(context),
+        onLongPress: () => _pickAndSend(context),
+        icon: const Icon(Icons.bug_report_outlined),
+      ),
+    );
+  }
+
+  static Future<void> _onTap(BuildContext context) async {
+    final roomId = AppSettings.diagnosticLogRoomId.value.trim();
+    final client = Matrix.of(context).client;
+    if (roomId.isEmpty || client.getRoomById(roomId) == null) {
+      await _pickAndSend(context);
+      return;
+    }
+    if (!context.mounted) return;
+    await _send(context);
+  }
+
+  static Future<void> _pickAndSend(BuildContext context) async {
+    final client = Matrix.of(context).client;
+    final chosen = await showAdaptiveBottomSheet<String>(
+      context: context,
+      builder: (context) => _DiagnosticRoomSheet(client: client),
+    );
+    if (chosen == null || chosen.isEmpty || !context.mounted) return;
+    await AppSettings.diagnosticLogRoomId.setItem(chosen);
+    if (!context.mounted) return;
+    await _send(context);
+  }
+
+  static Future<void> _send(BuildContext context) async {
+    final matrix = Matrix.of(context);
+    await showFutureLoadingDialog(
+      context: context,
+      future: () => DiagnosticTrace.send(
+        client: matrix.client,
+        resumeCutoff: matrix.lastBecameForegroundAt,
+      ),
+    );
+  }
+}
+
+class _DiagnosticRoomSheet extends StatefulWidget {
+  final Client client;
+
+  const _DiagnosticRoomSheet({required this.client});
+
+  @override
+  State<_DiagnosticRoomSheet> createState() => _DiagnosticRoomSheetState();
+}
+
+class _DiagnosticRoomSheetState extends State<_DiagnosticRoomSheet> {
+  late final TextEditingController _paste;
+  String? _selected;
+
+  @override
+  void initState() {
+    super.initState();
+    final saved = AppSettings.diagnosticLogRoomId.value.trim();
+    _selected = saved.isEmpty ? null : saved;
+    _paste = TextEditingController();
+  }
+
+  @override
+  void dispose() {
+    _paste.dispose();
+    super.dispose();
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final rooms = widget.client.rooms
+        .where((room) => !room.isSpace && room.membership == Membership.join)
+        .toList();
+    rooms.sort(
+      (a, b) => a
+          .uiDisplayname(MatrixLocals(L10n.of(context)))
+          .toLowerCase()
+          .compareTo(
+            b.uiDisplayname(MatrixLocals(L10n.of(context))).toLowerCase(),
+          ),
+    );
+    return SafeArea(
+      child: Column(
+        mainAxisSize: MainAxisSize.min,
+        crossAxisAlignment: CrossAxisAlignment.stretch,
+        children: [
+          Padding(
+            padding: const EdgeInsets.fromLTRB(16, 16, 16, 8),
+            child: Text(
+              'Send diagnostic logs',
+              style: Theme.of(context).textTheme.titleMedium,
+            ),
+          ),
+          Flexible(
+            child: ListView.builder(
+              shrinkWrap: true,
+              itemCount: rooms.length,
+              itemBuilder: (context, i) {
+                final room = rooms[i];
+                final name = room.uiDisplayname(MatrixLocals(L10n.of(context)));
+                return RadioListTile<String>(
+                  value: room.id,
+                  groupValue: _paste.text.trim().isEmpty ? _selected : null,
+                  title: Text(name, maxLines: 1, overflow: TextOverflow.ellipsis),
+                  subtitle: Text(
+                    room.id,
+                    maxLines: 1,
+                    overflow: TextOverflow.ellipsis,
+                  ),
+                  onChanged: (id) => setState(() {
+                    _selected = id;
+                    _paste.clear();
+                  }),
+                );
+              },
+            ),
+          ),
+          Padding(
+            padding: const EdgeInsets.fromLTRB(16, 8, 16, 8),
+            child: TextField(
+              controller: _paste,
+              decoration: const InputDecoration(
+                labelText: 'Or paste a room id',
+                isDense: true,
+              ),
+              onChanged: (_) => setState(() {}),
+            ),
+          ),
+          Padding(
+            padding: const EdgeInsets.fromLTRB(16, 0, 16, 16),
+            child: FilledButton(
+              onPressed: _roomId == null
+                  ? null
+                  : () => Navigator.of(context).pop(_roomId),
+              child: const Text('Send'),
+            ),
+          ),
+        ],
+      ),
+    );
+  }
+
+  String? get _roomId {
+    final pasted = _paste.text.trim();
+    if (pasted.isNotEmpty) {
+      return widget.client.getRoomById(pasted) == null ? null : pasted;
+    }
+    final selected = _selected;
+    if (selected == null || widget.client.getRoomById(selected) == null) {
+      return null;
+    }
+    return selected;
+  }
+}
