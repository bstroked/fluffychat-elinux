+import 'dart:async';
+import 'dart:io';
+
+import 'package:fluffychat/utils/custom_http_client.dart';
+import 'package:fluffychat/utils/diagnostic_trace.dart';
+import 'package:flutter/widgets.dart';
+import 'package:matrix/matrix.dart';
+import 'package:ut_media/ut_media.dart';
+
+/// Drops keep-alive sockets after a resume, a dead /sync, or a route change,
+/// then fetches pending events before the normal long-poll starts again.
+class SyncRecovery {
+  SyncRecovery._();
+
+  static const _watchdog = Duration(seconds: 10);
+  static const _routePoll = Duration(seconds: 2);
+
+  static final Map<String, StreamSubscription<SyncStatusUpdate>> _subs = {};
+  static List<Client> _clients = [];
+  static Timer? _routeTimer;
+  static Timer? _catchUpWatchdog;
+  static String? _route;
+  static bool _inRecovery = false;
+  static bool _recoverAgain = false;
+  static bool _rearming = false;
+  static bool _rearmAgain = false;
+
+  /// Re-register the Lomiri pusher. Set by the app once push is constructed.
+  static Future<void> Function()? rearmNotifier;
+
+  /// Set when a real timeout or connection failure happens outside recovery.
+  /// Cleared on the next successful sync. Errors caused by closing the old
+  /// client during recovery are not counted, so a normal open does not chime
+  /// twice.
+  static bool _errorStreak = false;
+  static bool _playedThisSync = false;
+  static bool _skippedOlderThisSync = false;
+
+  static void watch(Client client) {
+    if (_subs.containsKey(client.clientName)) return;
+    _subs[client.clientName] = client.onSyncStatus.stream.listen(
+      (update) => _onStatus(client, update),
+    );
+    if (!_clients.any((known) => known.clientName == client.clientName)) {
+      _clients = [..._clients, client];
+    }
+  }
+
+  static void unwatch(String clientName) {
+    _subs.remove(clientName)?.cancel();
+    _clients = [
+      for (final client in _clients)
+        if (client.clientName != clientName) client,
+    ];
+  }
+
+  static void watchRoutes(List<Client> clients) {
+    _clients = List<Client>.from(clients);
+    _route = _readRoute();
+    // Stays running in Recents. A network change drops lomiri-push-service's
+    // connection while this process is often still scheduled, and
+    // re-registering is what brings the next notification through. Sync is
+    // only restarted when the UI is actually resumed.
+    _routeTimer ??= Timer.periodic(_routePoll, (_) => _pollRoute());
+  }
+
+  static void stop() {
+    _routeTimer?.cancel();
+    _routeTimer = null;
+    _cancelCatchUpWatchdog();
+    for (final sub in _subs.values) {
+      sub.cancel();
+    }
+    _subs.clear();
+    _clients = [];
+  }
+
+  static Future<void> onResumed(
+    List<Client> clients, {
+    bool rearm = true,
+  }) async {
+    watchRoutes(clients);
+    await _recoverAll(clients);
+    if (rearm) unawaited(_rearm());
+  }
+
+  static void notePlayed() {
+    _playedThisSync = true;
+  }
+
+  static void noteSkippedOlder() {
+    _skippedOlderThisSync = true;
+  }
+
+  static void _onStatus(Client client, SyncStatusUpdate update) {
+    if (update.status == SyncStatus.finished) {
+      _onFinished();
+      return;
+    }
+    if (update.status != SyncStatus.error) return;
+    if (!_recoverable(update.error?.exception)) return;
+    // Closing the old client during recovery surfaces as this same error.
+    if (_inRecovery) return;
+    _errorStreak = true;
+    if (WidgetsBinding.instance.lifecycleState != AppLifecycleState.resumed) {
+      return;
+    }
+    unawaited(_recoverAll(_clients.isEmpty ? [client] : _clients));
+  }
+
+  static void _onFinished() {
+    _cancelCatchUpWatchdog();
+    final chime = _errorStreak && _skippedOlderThisSync && !_playedThisSync;
+    _errorStreak = false;
+    _playedThisSync = false;
+    _skippedOlderThisSync = false;
+    if (!chime) return;
+    DiagnosticTrace.add('catch-up chime after sync errors');
+    unawaited(_playCatchUp());
+  }
+
+  static Future<void> _playCatchUp() async {
+    try {
+      await UtMedia.playAlert();
+      await UtMedia.haptic();
+    } catch (e) {
+      DiagnosticTrace.add('catch-up chime failed ${e.runtimeType}');
+    }
+  }
+
+  static bool _recoverable(Object? exception) {
+    return exception is TimeoutException ||
+        exception is SyncConnectionException;
+  }
+
+  static Future<void> _recoverAll(List<Client> clients) async {
+    if (_inRecovery) {
+      _recoverAgain = true;
+      return;
+    }
+    _inRecovery = true;
+    try {
+      do {
+        _recoverAgain = false;
+        for (final client in clients) {
+          if (!client.isLogged()) continue;
+          await _recoverClient(client);
+        }
+      } while (_recoverAgain);
+    } finally {
+      _inRecovery = false;
+    }
+  }
+
+  static Future<void> _recoverClient(Client client) async {
+    DiagnosticTrace.add('sync recovery: drop sockets and catch up');
+    final status = client.onSyncStatus.value?.status;
+    final retryQueued =
+        client.syncPending && status != SyncStatus.waitingForResponse;
+    client.backgroundSync = false;
+    _recycle(client);
+    if (retryQueued) {
+      // The failed sync already scheduled its retry. That retry reads
+      // httpClient when it sends, so it picks up the sockets just installed.
+      // A second oneShotSync here would race it and drop one of the responses.
+      // No watchdog here: this retry is the normal long-poll, and a 10s
+      // timer left running would close that socket. A dead route fails the
+      // connect in 8s; a stuck long-poll fails the loop's own 40s timeout.
+      client.backgroundSync = true;
+      return;
+    }
+    await _waitUntilIdle(client);
+    final caughtUp = await _catchUp(client);
+    if (!caughtUp) {
+      DiagnosticTrace.add('sync recovery: catch-up still waiting, retrying');
+      client.backgroundSync = false;
+      _recycle(client);
+      await _waitUntilIdle(client);
+      await _catchUp(client);
+    }
+    client.backgroundSync = true;
+  }
+
+  static Future<void> _waitUntilIdle(Client client) async {
+    final deadline = DateTime.now().add(const Duration(seconds: 2));
+    while (client.syncPending && DateTime.now().isBefore(deadline)) {
+      await Future<void>.delayed(const Duration(milliseconds: 20));
+    }
+    if (!client.syncPending) return;
+    await client.abortSync();
+    await Future<void>.delayed(Duration.zero);
+  }
+
+  static void _cancelCatchUpWatchdog() {
+    _catchUpWatchdog?.cancel();
+    _catchUpWatchdog = null;
+  }
+
+  /// Returns true when the immediate sync finished. The 10s timer covers only
+  /// this zero-timeout catch-up. It is cancelled when that request ends, so
+  /// it cannot close the long-poll that starts afterward.
+  static Future<bool> _catchUp(Client client) async {
+    _cancelCatchUpWatchdog();
+    _catchUpWatchdog = Timer(_watchdog, () {
+      if (client.onSyncStatus.value?.status == SyncStatus.waitingForResponse) {
+        DiagnosticTrace.add('sync recovery: catch-up watchdog');
+        _recycle(client);
+      }
+    });
+    try {
+      await client.oneShotSync(timeout: Duration.zero);
+    } finally {
+      _cancelCatchUpWatchdog();
+    }
+    return client.onSyncStatus.value?.status == SyncStatus.finished;
+  }
+
+  static void _recycle(Client client) {
+    final outer = client.httpClient;
+    if (outer is! TimeoutHttpClient) return;
+    final previous = outer.inner;
+    outer.inner = CustomHttpClient.createHTTPClient();
+    previous.close();
+  }
+
+  static void _pollRoute() {
+    final next = _readRoute();
+    if (next == null) return;
+    final previous = _route;
+    _route = next;
+    if (previous == null || previous == next) return;
+    DiagnosticTrace.add('default route changed');
+    final foreground =
+        WidgetsBinding.instance.lifecycleState == AppLifecycleState.resumed;
+    if (foreground) unawaited(_recoverAll(_clients));
+    unawaited(_rearm());
+  }
+
+  static Future<void> _rearm() async {
+    final rearm = rearmNotifier;
+    if (rearm == null) return;
+    if (_rearming) {
+      _rearmAgain = true;
+      return;
+    }
+    _rearming = true;
+    try {
+      do {
+        _rearmAgain = false;
+        await rearm();
+      } while (_rearmAgain);
+    } finally {
+      _rearming = false;
+    }
+  }
+
+  /// `Iface destination gateway ... metric` for the default route.
+  static String? _readRoute() {
+    try {
+      final lines = File('/proc/net/route').readAsLinesSync();
+      final defaults = <String>[];
+      for (final line in lines.skip(1)) {
+        final parts = line.split(RegExp(r'\s+'));
+        if (parts.length < 7) continue;
+        if (parts[1] != '00000000') continue;
+        defaults.add('${parts[0]}:${parts[2]}:${parts[6]}');
+      }
+      if (defaults.isEmpty) return '';
+      defaults.sort();
+      return defaults.join(',');
+    } catch (_) {
+      return null;
+    }
+  }
+}
